# Copie para .env e preencha. O arquivo .env NUNCA deve ser versionado (RNF19).

DEBUG=True
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-longo
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

# Banco de dados — PostgreSQL local ou connection string do Supabase
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gradeacao
CONN_MAX_AGE=60
# Para rodar sem PostgreSQL local em desenvolvimento:
USE_SQLITE=False

# Supabase (Auth e Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# E-mail (produção)
DEFAULT_FROM_EMAIL=nao-responda@gradeacao.app
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
